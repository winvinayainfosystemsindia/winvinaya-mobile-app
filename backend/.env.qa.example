# WinVinaya LMS - QA Environment Variables
# Copy to backend/.env

# Database Configuration
POSTGRES_SERVER=qa-db-server
POSTGRES_PORT=5432
POSTGRES_DB=lms_qa
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=secure-password

# Application Configuration
SECRET_KEY=qa-secret-key-replace-with-secure-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=qa
APP_NAME="Winvinaya LMS [QA]"
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8001
WORKERS=4
BASE_URL=https://qa-api.winvinaya.com

# Redis / Celery / Cache (QA uses real Redis)
USE_REDIS=True
REDIS_URL=redis://qa-redis:6379/0
CELERY_BROKER_URL=redis://qa-redis:6379/0
CELERY_RESULT_BACKEND=redis://qa-redis:6379/1
REDIS_CACHE_DB=2
CACHE_DEFAULT_TTL=300

# File Upload & Media
STORAGE_ROOT=/app/storage
MAX_VIDEO_SIZE_MB=2048
ALLOWED_VIDEO_TYPES=[".mp4",".mov",".avi",".mkv",".webm"]

# OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=https://qa-api.winvinaya.com

# Video Sharing logic
SHARE_TOKEN_SECRET=qa-token-secret-replace-me
SHARE_TOKEN_TTL_SECONDS=86400

# Admin User
FIRST_SUPERUSER=admin@winvinaya.com
FIRST_SUPERUSER_PASSWORD=changeme123

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAILS_FROM_EMAIL=noreply@winvinaya.com
