# Application Configuration
APP_NAME="Winvinaya LMS [QA]"
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=False
ENVIRONMENT=qa

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database Configuration
POSTGRES_SERVER=qa-db-server
POSTGRES_USER=postgres
POSTGRES_PASSWORD=qa_secure_password
POSTGRES_DB=wvf_lms_qa
POSTGRES_PORT=5432

# Security
SECRET_KEY=qa_secret_key_change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Media Configuration
UPLOAD_DIR="/app/uploads"
MAX_CONTENT_LENGTH=2147483648  # 2GB
