# WinVinaya LMS - Production Environment Variables
# Copy to backend/.env

# Database Configuration
POSTGRES_SERVER=prod-db-server
POSTGRES_PORT=5432
POSTGRES_DB=lms_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_very_secure_production_password

# Application Configuration
SECRET_KEY=your-super-secure-production-key-MUST-BE-CHANGED
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=production
APP_NAME="Winvinaya LMS"
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=8002
WORKERS=8
BASE_URL=https://api.winvinaya.com

# Redis / Celery / Cache (Production MUST use Redis)
USE_REDIS=True
REDIS_URL=redis://prod-redis:6379/0
CELERY_BROKER_URL=redis://prod-redis:6379/0
CELERY_RESULT_BACKEND=redis://prod-redis:6379/1
REDIS_CACHE_DB=2
CACHE_DEFAULT_TTL=600

# File Upload & Media
STORAGE_ROOT=/data/storage
MAX_VIDEO_SIZE_MB=2048
ALLOWED_VIDEO_TYPES=[".mp4",".mov",".avi",".mkv",".webm"]

# OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=https://api.winvinaya.com

# Video Sharing logic
SHARE_TOKEN_SECRET=your-secure-share-token-secret
SHARE_TOKEN_TTL_SECONDS=86400

# Admin User
FIRST_SUPERUSER=admin@winvinaya.com
FIRST_SUPERUSER_PASSWORD=your_strong_password_here

# Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@winvinaya.com

# Logging
LOG_LEVEL=INFO
