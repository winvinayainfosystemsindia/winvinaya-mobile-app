PROJECT_NAME="Winvinaya LMS [DEV]"
API_V1_STR="/api/v1"
SECRET_KEY="development_secret_key_change_me"
ENVIRONMENT="development"

POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wvf_lms_dev
POSTGRES_PORT=5432

# Async Database URL
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}
# Sync Database URL (for Alembic)
SYNC_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# Media Configuration
UPLOAD_DIR="/app/uploads"
MAX_CONTENT_LENGTH=1073741824  # 1GB for videos
