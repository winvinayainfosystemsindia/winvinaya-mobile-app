# WinVinaya LMS - Development Environment Variables
# Copy to backend/.env

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lms_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=winvinaya12345

# Application Configuration
SECRET_KEY=dev-secret-key-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development
APP_NAME="Winvinaya LMS [DEV]"
DEBUG=true

# Server Configuration
HOST=127.0.0.1
PORT=8000
WORKERS=1
BASE_URL=http://localhost:8000

# Redis / Celery / Cache
# Set USE_REDIS=False for local Windows development without Redis.
USE_REDIS=False
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_CACHE_DB=2
CACHE_DEFAULT_TTL=300

# File Upload & Media
STORAGE_ROOT=./storage
MAX_VIDEO_SIZE_MB=2048
ALLOWED_VIDEO_TYPES=[".mp4",".mov",".avi",".mkv",".webm"]
MAX_FILE_SIZE_MB=50
ALLOWED_DOC_TYPES=[".pdf",".docx",".pptx",".xlsx",".zip",".txt"]

# OAuth Configuration (Optional for Dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000

# Video Sharing logic
SHARE_TOKEN_SECRET=dev-token-secret-change-me
SHARE_TOKEN_TTL_SECONDS=86400

# Admin User (for initial setup)
FIRST_SUPERUSER=admin@winvinaya.com
FIRST_SUPERUSER_PASSWORD=changeme123

# Email Configuration (Optional for Dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@winvinaya.com
